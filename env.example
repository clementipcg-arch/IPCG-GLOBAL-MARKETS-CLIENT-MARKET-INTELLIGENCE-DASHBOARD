# ---- Required in production ----
PUBLIC_URL=https://markets.yourdomain.com     # The https URL RMs share (used in link previews and share text)
ADMIN_TOKEN=change-me-to-a-long-random-string # Protects /admin (generate: openssl rand -hex 32)

# ---- Data providers (each one optional; missing keys show honest "not connected" states) ----
FRED_API_KEY=                 # Free: https://fred.stlouisfed.org/docs/api/api_key.html  (Fed H.10 FX, EIA energy, policy-rate cross-check)
EODHD_API_KEY=                # Licensed: indices, FX, commodities, movers, calendar, news. Confirm display/redistribution licence.
EODHD_LATENCY=delayed         # delayed | real-time | end-of-day — must match what your EODHD plan actually provides
ICE_BOFA_CLIENT_LICENCE=false # Set true ONLY after licensing ICE BofA index data for client display
HKMA_YIELD_ENDPOINT=          # Optional: HKMA Open API endpoint for EFN/HKGB yields (confirm on apidocs.hkma.gov.hk)
HKMA_YIELD_FIELD=             # Optional: field name of the 10-year yield in that endpoint
NEWS_TAGS=federal reserve,treasury yields,china economy,taiwan,bank of japan,oil prices,corporate bonds

# ---- AI drafting (optional; deterministic fact-only drafts work without it) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=              # e.g. a current Claude model id from https://docs.claude.com/en/docs/about-claude/models

# ---- Operations ----
PORT=8080
DATA_DIR=./data               # Briefing drafts, approvals and publication records (mount a persistent disk here)
SNAPSHOT_TTL_SECONDS=120
SNAPSHOT_REFRESH_SECONDS=300
QUOTE_TTL_SECONDS=300
DAILY_DRAFT_TIME_SGT=07:00    # Weekdays: prepare a daily draft for review (never auto-published)
WEEKLY_DRAFT_TIME_SGT=08:00   # Saturdays: prepare a weekly draft for review
ALERT_WEBHOOK_URL=            # Optional Slack/Teams webhook for repeated data-source failures
LOG_LEVEL=info
DEMO_MODE=false               # NEVER true on the client-facing deployment
APP_ENV=production
